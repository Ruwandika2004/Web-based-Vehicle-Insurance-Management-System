/* ==========================================================================
   SafeRide Portal & Dashboard Layout Styles - Pro Edition
   Modern InsurTech Operations UI/UX
   ========================================================================== */

.app-layout {
  display: flex;
  min-height: calc(100vh - 65px);
  background-color: var(--slate-50);
}

/* ==========================================================================
   Sidebar Navigation
   ========================================================================== */
.sidebar {
  width: 280px;
  background: var(--white);
  border-right: 1px solid var(--slate-200);
  padding: 1.75rem 1.15rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  flex-shrink: 0;
  box-shadow: var(--shadow-xs);
}

.sidebar-user {
  padding: 1.15rem;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: var(--radius);
  border: 1px solid var(--slate-200);
  margin-bottom: 1.5rem;
  position: relative;
  overflow: hidden;
}

.sidebar-user::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(to bottom, var(--primary-light), var(--primary));
  border-radius: 4px 0 0 4px;
}

.sidebar-user-name {
  font-weight: 700;
  font-size: 1rem;
  color: var(--slate-900);
  margin-bottom: 0.15rem;
}

.sidebar-user-email {
  font-size: 0.8rem;
  color: var(--slate-500);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-role-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--primary);
  background: var(--primary-subtle);
  border: 1px solid #bfdbfe;
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
  margin-top: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.sidebar-heading {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--slate-400);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.5rem 0.75rem 0.25rem;
  margin-top: 0.75rem;
}

.sidebar-menu {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: 0.95rem;
  padding: 0.75rem 1rem;
  border-radius: var(--radius-sm);
  color: var(--slate-600);
  font-weight: 600;
  font-size: 0.92rem;
  transition: var(--transition-fast);
  position: relative;
}

.sidebar-link i {
  font-size: 1.15rem;
  width: 22px;
  text-align: center;
  color: var(--slate-400);
  transition: var(--transition-fast);
}

.sidebar-link:hover {
  background: var(--slate-100);
  color: var(--slate-900);
}

.sidebar-link:hover i {
  color: var(--primary-light);
}

.sidebar-link.active {
  background: linear-gradient(135deg, var(--primary-subtle) 0%, #e0e7ff 100%);
  color: var(--primary);
  font-weight: 700;
  border-left: 3px solid var(--primary);
}

.sidebar-link.active i {
  color: var(--primary);
}

/* ==========================================================================
   Main Content Area
   ========================================================================== */
.main-content {
  flex: 1;
  padding: 2.25rem 2.5rem;
  background: var(--slate-50);
  overflow-y: auto;
  max-width: 1440px;
}

@media (max-width: 768px) {
  .app-layout {
    flex-direction: column;
  }
  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid var(--slate-200);
  }
  .main-content {
    padding: 1.5rem 1rem;
  }
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rem;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.page-title h1 {
  font-size: 1.95rem;
  margin-bottom: 0.35rem;
}

.page-title p {
  color: var(--slate-500);
  font-size: 0.95rem;
}

/* ==========================================================================
   KPI Stats Metric Cards Grid
   ========================================================================== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2.25rem;
}

.stat-card {
  background: var(--white);
  border-radius: var(--radius);
  border: 1px solid var(--slate-200);
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1.25rem;
  box-shadow: var(--shadow-sm);
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow);
  border-color: var(--slate-300);
}

.stat-icon {
  width: 54px;
  height: 54px;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  flex-shrink: 0;
}

.stat-icon.blue {
  background: var(--primary-subtle);
  color: var(--primary-light);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
}

.stat-icon.green {
  background: var(--secondary-subtle);
  color: var(--secondary-light);
  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
}

.stat-icon.amber {
  background: var(--accent-subtle);
  color: var(--accent);
  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);
}

.stat-icon.red {
  background: var(--danger-subtle);
  color: var(--danger);
  box-shadow: 0 4px 12px rgba(244, 63, 94, 0.2);
}

.stat-icon.purple {
  background: #f5f3ff;
  color: #8b5cf6;
  box-shadow: 0 4px 12px rgba(139, 92, 246, 0.2);
}

.stat-info h4 {
  font-size: 0.82rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--slate-500);
  margin-bottom: 0.35rem;
}

.stat-value {
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--slate-900);
  letter-spacing: -0.03em;
  line-height: 1.2;
}

/* ==========================================================================
   Quick Actions Grid
   ========================================================================== */
.actions-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
  margin-bottom: 2rem;
}

.action-tile {
  background: var(--white);
  border: 1px solid var(--slate-200);
  border-radius: var(--radius);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.75rem;
  text-decoration: none;
  transition: var(--transition);
  color: var(--slate-800);
}

.action-tile i {
  font-size: 1.75rem;
  color: var(--primary-light);
  background: var(--primary-subtle);
  width: 48px;
  height: 48px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-fast);
}

.action-tile:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
  border-color: var(--primary-light);
}

.action-tile:hover i {
  background: var(--primary);
  color: var(--white);
}

.action-tile strong {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--slate-900);
}

.action-tile .form-text {
  margin-top: 0;
}

/* ==========================================================================
   Claims Interactive Step Timeline
   ========================================================================== */
.claim-timeline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2.25rem 1.5rem;
  position: relative;
  margin: 1.5rem 0;
  background: var(--white);
  border-radius: var(--radius);
  border: 1px solid var(--slate-200);
}

.claim-timeline::before {
  content: '';
  position: absolute;
  top: 48px;
  left: 60px;
  right: 60px;
  height: 4px;
  background: var(--slate-200);
  z-index: 1;
}

.timeline-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
  text-align: center;
  width: 130px;
}

.step-circle {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--white);
  border: 3px solid var(--slate-300);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  color: var(--slate-400);
  margin-bottom: 0.85rem;
  transition: var(--transition);
}

.timeline-step.active .step-circle {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--white);
  box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.2);
  transform: scale(1.1);
}

.timeline-step.completed .step-circle {
  background: var(--secondary-light);
  border-color: var(--secondary);
  color: var(--white);
}

.timeline-step.rejected .step-circle {
  background: var(--danger-light);
  border-color: var(--danger);
  color: var(--white);
}

.step-label {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--slate-700);
  margin-bottom: 0.2rem;
}

.step-date {
  font-size: 0.75rem;
  color: var(--slate-400);
}
